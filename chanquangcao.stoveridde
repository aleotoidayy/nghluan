    - sayhentaii.art
    - sayhentaii.me
    - sayhentaii.live

scripting:
  script:
    - match: ^https?:\/\/.*sayhentaii\.(art|me|live)
      name: Sayhentaii
      type: response
      require-body: true
      max-size: 0
      binary-body-mode: 0
      debug: 1
      timeout: 10

