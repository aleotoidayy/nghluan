#!name= 𝗚𝗼𝗼𝗱𝗻𝗼𝘁𝗲𝘀
#!desc= 𝗯𝘆 𝗮𝗹𝗲𝗼𝗼

[MITM]
hostname = %APPEND% isi.csan.goodnotes.com

[Script]
Goodnotes = type=http-response,pattern=^https:\/\/isi\.csan\.goodnotes\.com\/.+\/(receipts$|subscribers\/[^/]+$),requires-body=true,max-size=-1,timeout=60,script-path=https://raw.githubusercontent.com/aleotoidayy/nghluan/aleoo/goodnotes.js
deleteHeader = type=http-request,pattern=^https:\/\/isi\.csan\.goodnotes\.com\/.+\/(receipts|subscribers),timeout=60,script-path=https://raw.githubusercontent.com/aleotoidayy/nghluan/aleoo/deleteheader.js
