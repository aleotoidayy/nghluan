name: aleo nho em
description: by aleoo
resource: true
priority: 100
mitm:
  hostname:
    - api.revenuecat.com
    - buy.itunes.apple.com
    - us-central1-alight-creative.cloudfunctions.net
    - api.alohaprofile.com
    - photos.adobe.io
    - api-mobile.soundcloud.com
    - spclient.wg.spotify.com
    - nicegram.cloud
    - api.picsart.com
    - "ap*.intsig.net"
    - "premium*.truecaller.com"
    - api-sub.meitu.com
    - mobile-api.adguard.org
    - accounts.google.com
scripts:
  - name: AdGuard
    script_url: https://raw.githubusercontent.com/aleotoidayy/nghluan/aleoo/adguard.js
    type: http-response
    pattern: ^https?:\/\/mobile-api\.adguard\.org\/api\/.+\/ios_validate_receipt
    requires_body: true
  - name: Alight Motion
    script_url: https://raw.githubusercontent.com/aleotoidayy/nghluan/aleoo/alightmotion.js
    type: http-response
    pattern: https://us-central1-alight-creative.cloudfunctions.net/getAccountStatusAndLicenses
    requires_body: true
    timeout: 5
  - name: AlohaVPN
    script_url: https://raw.githubusercontent.com/aleotoidayy/nghluan/aleoo/aloha.js
    type: http-response
    pattern: ^https:\/\/api\.alohaprofile\.com/v\d\/(profile_info|subscription_postback|profile_oauth)
    requires_body: true
  - name: LightRoom
    script_url: https://raw.githubusercontent.com/aleotoidayy/nghluan/aleoo/lightroom.js
    type: http-response
    pattern: ^https:\/\/photos\.adobe\.io\/v2\/accounts*
    requires_body: true
    max_size: 0
  - name: Locket Gold - revenuecat
    script_url: https://raw.githubusercontent.com/aleotoidayy/klinhh/klinhh/revenuecat.js
    type: http-response
    pattern: ^https:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/[^/]+$)
    requires_body: true
    max_size: -1
    timeout: 60
  - name: Locket Gold - deleteHeader
    script_url: https://raw.githubusercontent.com/aleotoidayy/klinhh/klinhh/deleteheader.js
    type: http-request
    pattern: ^https:\/\/api\.revenuecat\.com\/.+\/(receipts|subscribers)
    timeout: 60
  - name: SoundCloudGo+
    script_url: https://raw.githubusercontent.com/aleotoidayy/nghluan/aleoo/soundcloud.js
    type: http-response
    pattern: https://api-mobile.soundcloud.com/configuration/ios
    requires_body: true
  - name: Spotify JSON
    script_url: https://raw.githubusercontent.com/aleotoidayy/nghluan/aleoo/spotify-json.js
    type: http-request
    pattern: ^https:\/\/spclient\.wg\.spotify\.com\/(artistview\/v1\/artist|album-entity-view\/v2\/album)\/
  - name: Spotify Proto
    script_url: https://raw.githubusercontent.com/aleotoidayy/nghluan/aleoo/spotify-proto.js
    type: http-response
    pattern: ^https:\/\/spclient\.wg\.spotify\.com\/(bootstrap\/v1\/bootstrap|user-customization-service\/v1\/customize)$
    requires_body: true
    binary_mode: true
  - name: FIX-YouTube-Login
    script_url: https://raw.githubusercontent.com/aleotoidayy/nghluan/aleoo/loginyoutube.js
    type: http-request
    pattern: ^https:\/\/accounts\.google\.com\/embedded\/setup\/v2\/safarivc
    requires_body: true
    max_size: 0
  - name: Nicegram
    script_url: https://raw.githubusercontent.com/aleotoidayy/nghluan/aleoo/nicegram.js
    type: http-response
    pattern: ^https?:\/\/(nicegram\.cloud\/api\/v\d\/user\/info|restore-access\.indream\.app\/restoreAccess)
    requires_body: true
    max_size: 0
  - name: CamScanner
    script_url: https://raw.githubusercontent.com/aleotoidayy/nghluan/aleoo/camscanner.js
    type: http-response
    pattern: https:\/\/(api|api-cs.*)\.intsig\.net\/purchase\/cs\/query_property\?
    requires_body: true
  - name: PicsArt
    script_url: https://raw.githubusercontent.com/aleotoidayy/nghluan/aleoo/picsart.js
    type: http-request
    pattern: https://api.picsart.com/gw-v2/shop/subscription/apple/purchases
    requires_body: true
    timeout: 5
  - name: TrueCaller
    script_url: https://raw.githubusercontent.com/aleotoidayy/nghluan/aleoo/truecaller.js
    type: http-response
    pattern: ^https://premium-(.+)\.truecaller\.com/v\d/(subscriptions|products\/apple)
    requires_body: true
    max_size: 0
  - name: Wink
    script_url: https://raw.githubusercontent.com/aleotoidayy/nghluan/aleoo/wink.js
    type: http-response
    pattern: ^https:\/\/api-sub\.meitu\.com\/v\d\/user\/vip_info_by_group
    requires_body: true
    max_size: 0
