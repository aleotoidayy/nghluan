#!name= 𝗣𝗵𝗼𝘁𝗼𝗿𝗼𝗼𝗺
#!desc= 𝗯𝘆 𝗮𝗹𝗲𝗼𝗼

[MITM]
hostname= %APPEND% api.revenuecat.com, api.purchasely.io, api.photoroom.com
[Script]
Photoroom=type=http-response,pattern=^https?:\/\/api\.revenuecat\.com\/v1\/(subscribers\/[^\/]+$|receipts$),requires-body=1,script-path=https://raw.githubusercontent.com/aleotoidayy/nghluan/aleoo/photoroom.js

Photoroomm=type=http-response,pattern=api.purchasely.io||api.photoroom.com,requires-body=true,script-path=https://raw.githubusercontent.com/aleotoidayy/nghluan/aleoo/photoroomm.js
