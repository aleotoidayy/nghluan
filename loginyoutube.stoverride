#!name=Đăng Nhập YouTube Mod
#!desc=by aleoo

http:
  mitm:
    - accounts.google.com

  script:
    - name: FIX-YouTube-Login
      type: http-request
      match: ^https:\/\/accounts\.google\.com\/embedded\/setup\/v2\/safarivc
      requires-body: true
      max-size: 0
      script-url: https://raw.githubusercontent.com/aleotoidayy/nghluan/aleoo/loginyoutube.js
