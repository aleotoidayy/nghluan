#!name=𝙖𝙡𝙚𝙤 𝙣𝙝𝙤 𝙚𝙢
#!desc=𝙗𝙮 𝙖𝙡𝙚𝙤𝙤

http:
  mitm:
    - api.revenuecat.com
    - buy.itunes.apple.com
    - us-central1-alight-creative.cloudfunctions.net
    - api.alohaprofile.com
    - photos.adobe.io
    - api-mobile.soundcloud.com
    - spclient.wg.spotify.com
    - "*.googlevideo.com"
    - redirector*.googlevideo.com
    - www.youtube.com
    - s.youtube.com
    - youtubei.googleapis.com
    - nicegram.cloud
    - api.picsart.com
    - ap*.intsig.net
    - premium*.truecaller.com
    - api-sub.meitu.com
    - mobile-api.adguard.org
    - accounts.google.com

  script:
    - name: AdGuard
      type: http-response
      match: ^https?:\/\/mobile-api\.adguard\.org\/api\/.+\/ios_validate_receipt
      requires-body: true
      script-url: https://raw.githubusercontent.com/aleotoidayy/nghluan/aleoo/adguard.js

    - name: AlightMotion
      type: http-response
      match: ^https:\/\/us-central1-alight-creative.cloudfunctions.net\/getAccountStatusAndLicenses
      requires-body: true
      timeout: 5
      script-url: https://raw.githubusercontent.com/aleotoidayy/nghluan/aleoo/alightmotion.js

    - name: AlohaVPN
      type: http-response
      match: ^https:\/\/api\.alohaprofile\.com\/v\d+\/(profile_info|subscription_postback|profile_oauth)
      requires-body: true
      script-url: https://raw.githubusercontent.com/aleotoidayy/nghluan/aleoo/aloha.js

    - name: LightRoom
      type: http-response
      match: ^https:\/\/photos\.adobe\.io\/v2\/accounts.*
      requires-body: true
      max-size: 0
      script-url: https://raw.githubusercontent.com/aleotoidayy/nghluan/aleoo/lightroom.js

    - name: revenuecat
      type: http-response
      match: ^https:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/[^/]+$)
      requires-body: true
      max-size: -1
      timeout: 60
      script-url: https://raw.githubusercontent.com/aleotoidayy/klinhh/klinhh/revenuecat.js

    - name: deleteHeader
      type: http-request
      match: ^https:\/\/api\.revenuecat\.com\/.+\/(receipts|subscribers)
      timeout: 60
      script-url: https://raw.githubusercontent.com/aleotoidayy/klinhh/klinhh/deleteheader.js

    - name: FIX-YouTube-Login
      type: http-request
      match: ^https:\/\/accounts\.google\.com\/embedded\/setup\/v2\/safarivc
      requires-body: true
      max-size: 0
      script-url: https://raw.githubusercontent.com/aleotoidayy/nghluan/aleoo/loginyoutube.js

    - name: SoundCloudGo
      type: http-response
      match: ^https:\/\/api-mobile\.soundcloud\.com\/configuration\/ios
      requires-body: true
      script-url: https://raw.githubusercontent.com/aleotoidayy/nghluan/aleoo/soundcloud.js

    - name: spotify-json
      type: http-request
      match: ^https:\/\/spclient\.wg\.spotify\.com\/(artistview\/v1\/artist|album-entity-view\/v2\/album)\/
      script-url: https://raw.githubusercontent.com/aleotoidayy/nghluan/aleoo/spotify-json.js

    - name: spotify-proto
      type: http-response
      match: ^https:\/\/spclient\.wg\.spotify\.com\/(bootstrap\/v1\/bootstrap|user-customization-service\/v1\/customize)$
      requires-body: true
      binary-mode: true
      script-url: https://raw.githubusercontent.com/aleotoidayy/nghluan/aleoo/spotify-proto.js

    - name: youtube.response
      type: http-response
      match: ^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/(browse|next|player|search|reel\/reel_watch_sequence|guide|account\/get_setting|get_watch)
      requires-body: true
      binary-body-mode: true
      max-size: -1
      engine: default
      script-url: https://raw.githubusercontent.com/aleotoidayy/nghluan/aleoo/youtube.js
      argument: "{}"

    - name: Nicegram
      type: http-response
      match: ^https?:\/\/(nicegram\.cloud\/api\/v\d\/user\/info|restore-access\.indream\.app\/restoreAccess)
      requires-body: true
      max-size: 0
      script-url: https://raw.githubusercontent.com/aleotoidayy/nghluan/aleoo/nicegram.js

    - name: Camscanner
      type: http-response
      match: ^https:\/\/(api|api-cs.*)\.intsig\.net\/purchase\/cs\/query_property\?
      requires-body: true
      script-url: https://raw.githubusercontent.com/aleotoidayy/nghluan/aleoo/camscanner.js

    - name: Picsart
      type: http-request
      match: ^https:\/\/api\.picsart\.com\/gw-v2\/shop\/subscription\/apple\/purchases
      requires-body: true
      timeout: 5
      script-url: https://raw.githubusercontent.com/aleotoidayy/nghluan/aleoo/picsart.js

    - name: Truecaller
      type: http-response
      match: ^https:\/\/premium-(.+)\.truecaller\.com\/v\d\/(subscriptions|products\/apple)
      requires-body: true
      max-size: 0
      script-url: https://raw.githubusercontent.com/aleotoidayy/nghluan/aleoo/truecaller.js

    - name: Wink
      type: http-response
      match: ^https:\/\/api-sub\.meitu\.com\/v\d\/user\/vip_info_by_group
      requires-body: true
      max-size: 0
      script-url: https://raw.githubusercontent.com/aleotoidayy/nghluan/aleoo/wink.js
