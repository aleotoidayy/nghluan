#!name= 𝗖𝗼𝗹𝗼𝗿 𝗪𝗶𝗱𝗴𝗲𝘁𝘀
#!desc= 𝗯𝘆 𝗮𝗹𝗲𝗼𝗼

[MITM]
hostname= %APPEND% api.revenuecat.com
[Script]
ColorWidgets=type=http-response,pattern=^https?:\/\/api\.revenuecat\.com\/v1\/(subscribers\/[^\/]+$|receipts$),requires-body=1,script-path=https://raw.githubusercontent.com/aleotoidayy/nghluan/aleoo/colorwidgets.js
deleteHeader=type=http-request,pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts|subscribers), timeout=60,script-path=https://raw.githubusercontent.com/aleotoidayy/nghluan/aleoo/deleteheader.js
