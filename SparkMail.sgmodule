#!name= 𝗦𝗽𝗮𝗿𝗸 𝗠𝗮𝗶𝗹
#!desc= 𝗯𝘆 𝗮𝗹𝗲𝗼𝗼

[MITM]
hostname = %APPEND% api.revenuecat.com
[Script]
SparkMail = type=http-response, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/[^/]+$), requires-body=true, max-size=-1, timeout=60, script-path=https://raw.githubusercontent.com/aleotoidayy/nghluan/aleoo/sparkmail.js
deleteHeader = type=http-request, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts|subscribers), timeout=60, script-path=https://raw.githubusercontent.com/aleotoidayy/nghluan/aleoo/deleteheader-v3.js
