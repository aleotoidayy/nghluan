#!name= 𝗩𝗦𝗖𝗢
#!desc= 𝗯𝘆 𝗮𝗹𝗲𝗼𝗼 

[MITM]
hostname = api.revenuecat.com, subscriptions-api.superwall.com

[Script]
vsco = type=http-response, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/[^/]+$), requires-body=true, timeout=5, script-path=https://raw.githubusercontent.com/aleotoidayy/nghluan/aleoo/vsco.js
vscoo = type=http-response, pattern=^https:\/\/subscriptions-api\.superwall\.com\/subscriptions-api\/public\/v1\/(redeem|users\/[^\/]+\/entitlements)(\?.*)?$, requires-body=true, timeout=5, script-path=https://raw.githubusercontent.com/aleotoidayy/nghluan/aleoo/vscoo.js
