#!name= 𝗣𝗶𝗰𝘀𝗮𝗿𝘁
#!desc= 𝗯𝘆 𝗮𝗹𝗲𝗼𝗼

[Header Rewrite]
^https:\/\/api\.(picsart|meiease)\.c(n|om)\/users\/show\/me\.json header-del if-none-match

[MITM]
hostname = %APPEND% api.picsart.com

[Script]
Picsart=type=http-request,pattern=https:\/\/api\.picsart\.com\/gw-v2\/shop\/subscription\/apple\/purchases$,requires-body=true,timeout=5,script-path=https://raw.githubusercontent.com/aleotoidayy/nghluan/aleoo/picsart.js

Picsartt=type=http-response,pattern=^https:\/\/api\.picsart\.com\/gw-v2\/cloud-storage\/v1\/me\/storages$,timeout=60,script-path=https://raw.githubusercontent.com/aleotoidayy/nghluan/aleoo/picsartt.js
